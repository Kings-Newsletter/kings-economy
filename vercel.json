{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/noticias.ts": {
      "regions": ["gru1"],
      "maxDuration": 15
    }
  },
  "redirects": [{ "source": "/", "destination": "/economy/", "permanent": false }],
  "rewrites": [
    { "source": "/economy/api/:path*", "destination": "/api/:path*" },
    { "source": "/economy", "destination": "/index.html" },
    { "source": "/economy/:path*", "destination": "/:path*" }
  ]
}

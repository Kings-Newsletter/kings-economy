# Copie para .env e preencha. Nunca envie o .env para o repositório.

# brapi (https://brapi.dev): token para a faixa da B3 e as páginas de ações.
# Sem ele, só as 4 ações de demonstração (PETR4, VALE3, ITUB4, MGLU3).
# Atenção: variáveis VITE_ vão para o JavaScript publicado.
VITE_BRAPI_TOKEN=

# MongoDB das notícias (usado só no servidor, em /api/noticias).
MONGODB_URI=
MONGODB_DB=
MONGODB_COLLECTION=economia
